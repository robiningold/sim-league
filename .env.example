# Supabase → Project Settings → API
# Beide Werte sind öffentlich unbedenklich; der Schutz kommt über die
# Zugriffsregeln in supabase/schema.sql, nicht über Geheimhaltung.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Gemeinsames Liga-Konto. Muss in Supabase unter Authentication → Users
# angelegt sein (Auto Confirm aktivieren). Das Passwort tippt ihr in der App.
VITE_TEAM_EMAIL=team@sim-league.app
